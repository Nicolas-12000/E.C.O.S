ENV=dev
DEBUG=true

# Render / producción
# ECOS_FULL_API=true
# GRPC_PORT=0
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:3000
# CORS_ALLOW_VERCEL=true

# ── Groq (LLM para RAG) ────────────────────────────
GROQ_API_KEY=
