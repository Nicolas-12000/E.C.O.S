SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database PostgreSQL local (opcional — el backend funciona sin DB) ─
# Formato: postgresql://user:password@localhost:5432/ecos
DATABASE_URL=
SUPABASE_DB_URL=

# Chat IA — login demo (migración 0007)
CHAT_DEMO_AUTH_REQUIRED=true
