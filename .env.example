ENV=dev
DEBUG=true

# Render / producción
# ECOS_FULL_API=true
# GRPC_PORT=0
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:3000

# ── Groq (LLM para RAG) ────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase (opcional — dejar vacío si no se usa) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database PostgreSQL local (opcional — el backend funciona sin DB) ─
# Formato: postgresql://user:password@localhost:5432/ecos
DATABASE_URL=
SUPABASE_DB_URL=